# https://console.apify.com/settings/integrations
APIFY_TOKEN=your_apify_token_here

# Matches docker-compose.yml
DATABASE_URL=postgres://leads:leads@localhost:5432/leads

# Companies per Clutch directory page in searches.txt
MAX_PER_SEARCH=30

# Decision makers are searched for companies scoring at least MIN_SCORE,
# at most MAX_COMPANIES per run, best first. Each company is searched only once.
MIN_SCORE=75
MAX_COMPANIES=10
TITLES=CEO,Founder,CTO,VP Engineering
PERSONS_PER_COMPANY=2
# Only decision makers based here (a country or state is safer than a city); empty = anywhere
LOCATION=United States
